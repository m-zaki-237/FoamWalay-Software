{
  "name": "foamwalay",
  "version": "1.0.0",
  "description": "Local-first inventory, sales, and financial app for Al Harmain Foam Center",
  "author": "Al Harmain Foam Center",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev:desktop": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"wait-on http://localhost:5173 && cross-env FOAMWALAY_DEV_DESKTOP=true electron .\"",
    "build": "npm --prefix client run build",
    "electron": "electron .",
    "dist": "npm run build && electron-builder --win",
    "seed": "node server/seed.js",
    "reset": "node server/reset.js",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "fast-csv": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "supertest": "^6.3.4",
    "vitest": "^1.5.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.alharmain.foamwalay",
    "productName": "FoamWalay",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "client/dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FoamWalay"
    }
  }
}
